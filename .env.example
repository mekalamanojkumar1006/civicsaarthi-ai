# CivicSaarthi AI – Environment Configuration
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.local`:
#    cp .env.example .env.local
# 2. Fill in your project values below.
# 3. NEVER commit `.env` or `.env.local` to source control.
# 4. NEVER use the Supabase `service_role` key in frontend code or VITE_ variables.
#    Only the public `anon` / `publishable` key is safe for client applications.

# ── Supabase Backend ────────────────────────────────────────────────────────
# Obtain these from: Supabase Dashboard → Project Settings → API
# URL should look like: https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable / Anon API Key (safe for browser client with Row Level Security)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
# Legacy / alternative alias for anon key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# ── Google Gemini AI (Stage 4.2 - Do NOT use yet) ───────────────────────────
# Get this from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── Application Metadata ───────────────────────────────────────────────────
VITE_APP_NAME=CivicSaarthi AI
VITE_APP_ENV=development
